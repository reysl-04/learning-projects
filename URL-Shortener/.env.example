# Copy to .env (optional). Every value has a sensible default.

PORT=3000
HOST=127.0.0.1

# Used to build the short URL returned by the API. Behind a proxy/CDN this
# should be the public origin, e.g. https://sho.rt
BASE_URL=http://localhost:3000

# SQLite file. Use :memory: for an ephemeral instance.
DB_PATH=./data/links.db

# Length of generated codes (base62). 7 chars ~= 3.5 trillion combinations.
CODE_LENGTH=7

# In-process LRU cache (stands in for Redis in a real deployment).
CACHE_SIZE=10000
CACHE_TTL_MS=60000
NEGATIVE_CACHE_TTL_MS=5000

# Creation requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=30

# Default link lifetime in seconds; 0 means links never expire.
DEFAULT_TTL_SECONDS=0

# How often expired rows are swept from SQLite.
CLEANUP_INTERVAL_MS=300000
